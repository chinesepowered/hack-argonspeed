# Copy to .env (git ignores it), or set these as environment variables in the cloud
# environment's settings so new sessions get them.

# Gemini API key with access to gemini-4-argon (Argon isn't on the free tier).
GEMINI_API_KEY=

# Open Kernel Challenge token: `okc api token` on a machine that's signed in with `okc login`.
OKC_TOKEN=

# ElevenLabs, for the narrated pitch video (scripts/video.py)
ELEVENLABS_API_KEY=
